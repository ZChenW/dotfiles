{
    // Waybar discovers the backlight when no device is specified. On desktops
    // it disables the native backlight modules; DDC is offered only if readable.
    "group/ddcutil": {
        "orientation": "inherit",
        "drawer": { "transition-left-to-right": false },
        "modules": ["backlight#stat", "backlight/slider", "backlight", "custom/external-brightness"]
    },
    "custom/external-brightness": {
        "exec": "\"${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts/external-brightness.sh\"",
        "return-type": "json",
        "hide-empty-text": true,
        "interval": 30,
        "signal": 11,
        "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --external --set-percent 100; pkill -RTMIN+11 -x waybar",
        "on-scroll-up": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --external +5%; pkill -RTMIN+11 -x waybar",
        "on-scroll-down": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --external -5%; pkill -RTMIN+11 -x waybar"
    },
    "include": ["brightness-edp.jsonc"]
}
