{
  "backlight/slider": {
    "min": 5,
    "max": 98,
    "orientation": "horizontal"
  },
  "backlight": {
    "tooltip": true,
    "tooltip-format": "此屏幕亮度\n滚轮调节",
    "format": "{icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "on-scroll-up": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --output internal +5%",
    "on-scroll-down": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --output internal -5%"
  },
  "group/ddcutil": {
    "orientation": "inherit",
    "drawer": {
      "transition-left-to-right": false
    },
    "modules": [
      "backlight#stat",
      "backlight/slider",
      "backlight",
      "custom/separator#1",
      "custom/ddcutil-sleep",
      "custom/ddcutil-night"
    ]
  },
  "backlight#stat": {
    "tooltip-format": "此屏幕亮度：{percent}%\n左键：100%\n滚轮：±5%\n右键：切换护眼模式",
    "format": "󰃠 {percent}%",
    "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --output internal --set-percent 100",
    "on-click-right": "~/.local/bin/toggle-wlsunset",
    "on-scroll-up": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --output internal +5%",
    "on-scroll-down": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --output internal -5%"
  },
  "custom/ddcutil-night": {
    "tooltip-format": "左键：65%此屏幕亮度\n滚轮：±5%",
    "format": "󰃟",
    "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --output internal --set-percent 65",
    "on-scroll-up": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --output internal +5%",
    "on-scroll-down": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --output internal -5%"
  },
  "custom/ddcutil-sleep": {
    "tooltip-format": "左键：5%此屏幕亮度\n滚轮：±5%",
    "format": "󰃞",
    "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --output internal --set-percent 5",
    "on-scroll-up": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --output internal +5%",
    "on-scroll-down": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --output internal -5%"
  }
}
