{
  "group/ddcutil": {
    "orientation": "inherit",
    "drawer": {
      "transition-left-to-right": false
    },
    "modules": [
      "custom/ddcutil-day",
      "cffi/brightness",
      "custom/separator#1",
      "custom/ddcutil-sleep",
      "custom/ddcutil-night"
    ]
  },
  "custom/ddcutil-day": {
    // 百分比由 brightness.sh 读取；CFFI 滑块写入完成后会发 RTMIN+11 触发刷新。
    "exec": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --external --get | cut -d, -f4",
    "interval": 30,
    "signal": 11,
    "tooltip-format": "此屏幕亮度：{}%\n左键：100%\n滚轮：±5%\n右键：切换护眼模式",
    "format": "󰃠 {}%",
    "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --external --set-percent 100; pkill -RTMIN+11 -x waybar",
    "on-click-right": "~/.local/bin/toggle-wlsunset",
    "on-scroll-up": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --external +5%; pkill -RTMIN+11 -x waybar",
    "on-scroll-down": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --external -5%; pkill -RTMIN+11 -x waybar"
  },
  "custom/ddcutil-night": {
    "tooltip-format": "左键：65%此屏幕亮度\n滚轮：±5%",
    "format": "󰃟",
    "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --external --set-percent 65; pkill -RTMIN+11 -x waybar",
    "on-scroll-up": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --external +5%; pkill -RTMIN+11 -x waybar",
    "on-scroll-down": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --external -5%; pkill -RTMIN+11 -x waybar"
  },
  "custom/ddcutil-sleep": {
    "tooltip-format": "左键：5%此屏幕亮度\n滚轮：±5%",
    "format": "󰃞",
    "on-click": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --external --set-percent 5; pkill -RTMIN+11 -x waybar",
    "on-scroll-up": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --external +5%; pkill -RTMIN+11 -x waybar",
    "on-scroll-down": "\"${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/brightness.sh\" --external -5%; pkill -RTMIN+11 -x waybar"
  }
}
