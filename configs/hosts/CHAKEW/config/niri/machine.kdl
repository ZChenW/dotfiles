// DP-8 is wired to the NVIDIA GPU while eDP-1 is on the AMD iGPU. Rendering on
// the iGPU forced every external-monitor frame through a cross-GPU copy that
// capped it at ~22 fps. Render where the external output is attached instead.
// Revert by deleting this block if the laptop panel regresses.
debug {
    render-drm-device "/dev/dri/renderD129"
}
