#!/usr/bin/env bash
set -euo pipefail

WAYBAR_LOG="${WAYBAR_LOG:-/tmp/waybar-toggle.log}"
INIR_LOG="${INIR_LOG:-/tmp/inir-toggle.log}"
INIR_RUNTIME="${INIR_RUNTIME:-$HOME/.config/quickshell/inir}"

have() { command -v "$1" >/dev/null 2>&1; }

start_waybar() {
    if ! have waybar; then
        echo "waybar not found" >&2
        exit 1
    fi

    if have systemctl \
        && systemctl --user cat waybar.service >/dev/null 2>&1; then
        systemctl --user start waybar.service
    else
        nohup waybar >"$WAYBAR_LOG" 2>&1 &
    fi
}

start_qs_runtime() {
    local bin="$1"

    if [ -d "$INIR_RUNTIME" ]; then
        nohup "$bin" -n -p "$INIR_RUNTIME" >"$INIR_LOG" 2>&1 &
    else
        nohup "$bin" -c ii >"$INIR_LOG" 2>&1 &
    fi
}

start_inir() {
    if have inir; then
        nohup inir run >"$INIR_LOG" 2>&1 &
    elif have qs; then
        start_qs_runtime qs
    elif have quickshell; then
        start_qs_runtime quickshell
    else
        echo "No iNiR launcher found: tried inir, qs, quickshell" >&2
        exit 1
    fi
}

is_waybar_running() {
    pgrep -x waybar >/dev/null 2>&1
}

is_inir_running() {
    pgrep -f '(^|/| )inir[[:space:]]+run([[:space:]]|$)' >/dev/null 2>&1 \
        || pgrep -f '(^|/| )qs([[:space:]].*)?(-c[[:space:]]+ii|-p[[:space:]]+.*quickshell/(inir|ii))' >/dev/null 2>&1 \
        || pgrep -f '(^|/| )quickshell([[:space:]].*)?(-c[[:space:]]+ii|-p[[:space:]]+.*quickshell/(inir|ii))' >/dev/null 2>&1 \
        || { have qs && qs list --all 2>/dev/null | grep -Eq 'Shell ID:[[:space:]]*(inir|ii)([[:space:]]|$)'; }
}

stop_waybar() {
    if have systemctl \
        && systemctl --user is-active --quiet waybar.service 2>/dev/null; then
        systemctl --user stop waybar.service 2>/dev/null || true
    fi

    pkill -x waybar 2>/dev/null || true
}

stop_inir() {
    if have inir; then
        inir stop >/dev/null 2>&1 || true
    fi

    pkill -f '(^|/| )inir[[:space:]]+run([[:space:]]|$)' 2>/dev/null || true
    pkill -f '(^|/| )qs([[:space:]].*)?(-c[[:space:]]+ii|-p[[:space:]]+.*quickshell/(inir|ii))' 2>/dev/null || true
    pkill -f '(^|/| )quickshell([[:space:]].*)?(-c[[:space:]]+ii|-p[[:space:]]+.*quickshell/(inir|ii))' 2>/dev/null || true
}

wait_until_stopped() {
    local check_fn="$1"

    for _ in {1..20}; do
        "$check_fn" || return 0
        sleep 0.1
    done
}

if is_waybar_running && is_inir_running; then
    stop_inir
    stop_waybar
    wait_until_stopped is_inir_running
    wait_until_stopped is_waybar_running
    start_waybar
elif is_waybar_running; then
    stop_waybar
    wait_until_stopped is_waybar_running
    start_inir
elif is_inir_running; then
    stop_inir
    wait_until_stopped is_inir_running
    start_waybar
else
    start_waybar
fi
