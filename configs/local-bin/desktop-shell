#!/usr/bin/env bash
# Switch between the current Waybar desktop and the local QuickShell config.

set -euo pipefail

PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:$PATH"

worker_mode=false
action="${1:-status}"
if [[ "$action" == --worker ]]; then
    worker_mode=true
    shift
    action="${1:-}"
fi
status_format=auto

state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
state_dir="$state_home/dotfiles"
state_file="$state_dir/desktop-shell"
profile_file="$state_dir/desktop-shell-profile"
lock_file="$state_dir/desktop-shell.lock"
log_file="$state_dir/desktop-shell.log"
config_path_marker="$state_dir/quickshell-config-path"
idle_control_marker="$state_home/idle-control/active"
swayidle_script="${XDG_CONFIG_HOME:-$HOME/.config}/niri/scripts/swayidle.sh"
notification_bus_name=org.freedesktop.Notifications
notify_enabled="${DESKTOP_SHELL_NOTIFY:-1}"
script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
legacy_default_quickshell_config="${XDG_DATA_HOME:-$HOME/.local/share}/quickshell/clavis"
desktop_shell_profile=dual
desktop_integration_probed=false
desktop_integration_version=""
quickshell_prepared_for_waybar=false
quickshell_wallpaper_retained=false

if [[ -f "$profile_file" ]]; then
    read -r desktop_shell_profile <"$profile_file" || desktop_shell_profile=dual
fi
case "$desktop_shell_profile" in
    waybar | quickshell | dual) ;;
    *) desktop_shell_profile=dual ;;
esac

usage() {
    cat >&2 <<'EOF'
Usage: desktop-shell {start|toggle|waybar|quickshell|status|switcher|launcher|lock|hub|tools|control-center}
       desktop-shell status --plain
EOF
}

case "$action" in
    start | toggle | waybar | quickshell | status | switcher | launcher | lock | hub | tools | control-center)
        ;;
    *)
        usage
        exit 2
        ;;
esac

if (($# > 1)); then
    if [[ "$action" == status && "$#" == 2 && "${2:-}" == --plain ]]; then
        status_format=plain
    else
        usage
        exit 2
    fi
fi

if [[ "$worker_mode" == true ]]; then
    case "$action" in
        start | toggle | waybar | quickshell) ;;
        *)
            echo "desktop-shell: invalid worker action: $action" >&2
            exit 2
            ;;
    esac
fi

mkdir -p "$state_dir"
touch "$log_file"

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$log_file"
}

notify() {
    [[ "$notify_enabled" == 1 ]] || return 0
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send "Desktop shell" "$1" >/dev/null 2>&1 || true
}

resolve_quickshell_config() {
    local candidate=""

    if [[ -n "${QUICKSHELL_CONFIG_PATH:-}" ]]; then
        printf '%s\n' "$QUICKSHELL_CONFIG_PATH"
        return 0
    fi

    if [[ -f "$config_path_marker" ]]; then
        IFS= read -r candidate <"$config_path_marker" || candidate=""
        candidate="${candidate#"${candidate%%[![:space:]]*}"}"
        candidate="${candidate%"${candidate##*[![:space:]]}"}"
        if [[ "$candidate" == /* && -f "$candidate/shell.qml" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
        log "ignoring invalid quickshell-config-path marker: ${candidate:-<empty>}"
    fi

    printf '%s\n' "$legacy_default_quickshell_config"
}

quickshell_config="$(resolve_quickshell_config)"

# Plain path markers, never sourced as shell code. Explicit environment wins.
if [[ -f "$quickshell_config/AppShell.qml" && ! -f "$quickshell_config/controlcenter.qml" ]]; then
    if [[ -z "${CLAVIS_KEY:-}" && -f "$state_dir/quickshell-key-path" ]]; then
        IFS= read -r candidate_key <"$state_dir/quickshell-key-path" || candidate_key=""
        if [[ "$candidate_key" == /* && -x "$candidate_key" ]]; then
            export CLAVIS_KEY="$candidate_key"
        fi
    fi
    if [[ -z "${QUICKSHELL_EXTRA_QML_PATH:-}" && -f "$state_dir/quickshell-extra-qml-path" ]]; then
        IFS= read -r candidate_qml <"$state_dir/quickshell-extra-qml-path" || candidate_qml=""
        if [[ "$candidate_qml" == /* && -d "$candidate_qml" ]]; then
            export QUICKSHELL_EXTRA_QML_PATH="$candidate_qml"
        fi
    fi
    # Disable internal idle actions from the first frame, before IPC is ready.
    export CLAVIS_EXTERNAL_IDLE_OWNER=0
    [[ ! -f "$idle_control_marker" ]] || export CLAVIS_EXTERNAL_IDLE_OWNER=1
    # Clavis jemalloc defaults: skip only when the session already set MALLOC_CONF
    # (including an explicit empty value). Matches docs/development.md.
    if [[ ! -v MALLOC_CONF ]]; then
        export MALLOC_CONF='thp:never,narenas:4,dirty_decay_ms:3000'
    fi
fi

configure_qml_import_path() {
    local user_qml_dir="$HOME/.local/lib/qt6/qml"
    local build_qml="$quickshell_config/build/qml"

    case ":${QML_IMPORT_PATH:-}:" in
        *":$user_qml_dir:"*) ;;
        *) QML_IMPORT_PATH="$user_qml_dir${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}" ;;
    esac

    if [[ -n "${QUICKSHELL_EXTRA_QML_PATH:-}" && -d "$QUICKSHELL_EXTRA_QML_PATH" ]]; then
        QML_IMPORT_PATH="$QUICKSHELL_EXTRA_QML_PATH${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
        # User-level Qt dependencies can also provide location plugins and
        # their shared libraries. Keep their lookup scoped to this shell.
        local dependency_lib dependency_plugins
        dependency_lib="$(readlink -f -- "$QUICKSHELL_EXTRA_QML_PATH/../..")"
        dependency_plugins="$(readlink -f -- "$QUICKSHELL_EXTRA_QML_PATH/../plugins")"
        if [[ "$QUICKSHELL_EXTRA_QML_PATH" == */lib/qt6/qml && -d "$dependency_lib" ]]; then
            export LD_LIBRARY_PATH="$dependency_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        fi
        if [[ "$QUICKSHELL_EXTRA_QML_PATH" == */lib/qt6/qml && -d "$dependency_plugins" ]]; then
            export QT_PLUGIN_PATH="$dependency_plugins${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
        fi
    fi

    # Upstream build trees must win over an older global Clavis install.
    if [[ -d "$build_qml" ]]; then
        QML_IMPORT_PATH="$build_qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"
    fi

    export QML_IMPORT_PATH
}

configure_qml_import_path

# Propagate an absolute key-cli when the session already exported one.
if [[ -n "${CLAVIS_KEY:-}" ]]; then
    export CLAVIS_KEY
fi

reset_desktop_integration_cache() {
    desktop_integration_probed=false
    desktop_integration_version=""
    quickshell_prepared_for_waybar=false
}

quickshell_is_upstream_tree() {
    [[ -f "$quickshell_config/shell.qml" ]] \
        && [[ -f "$quickshell_config/AppShell.qml" ]] \
        && [[ ! -f "$quickshell_config/controlcenter.qml" ]]
}

validate_profile_action() {
    case "$desktop_shell_profile:$action" in
        waybar:toggle | waybar:quickshell)
            echo "desktop-shell: profile is waybar; reinstall with --desktop-shell dual or quickshell" >&2
            return 1
            ;;
        quickshell:toggle | quickshell:waybar)
            echo "desktop-shell: profile is quickshell; reinstall with --desktop-shell dual or waybar" >&2
            return 1
            ;;
    esac
}

start_detached() {
    if command -v setsid >/dev/null 2>&1; then
        setsid -f "$@" >>"$log_file" 2>&1 9>&-
    else
        nohup "$@" >>"$log_file" 2>&1 9>&- &
        disown || true
    fi
}

switch_lock_available() {
    command -v flock >/dev/null 2>&1 || return 0
    flock -n "$lock_file" true >/dev/null 2>&1
}

acquire_switch_lock() {
    command -v flock >/dev/null 2>&1 || return 0
    exec 9>"$lock_file"
    if ! flock -n 9; then
        log "ignored $action request because another switch is in progress"
        return 1
    fi
}

dispatch_switch() {
    if ! switch_lock_available; then
        echo "desktop-shell: another switch is already running" >&2
        return 1
    fi

    if [[ "${DESKTOP_SHELL_FOREGROUND:-0}" == 1 ]]; then
        exec "$script_path" --worker "$action"
    fi

    if command -v setsid >/dev/null 2>&1; then
        setsid -f "$script_path" --worker "$action" \
            </dev/null >>"$log_file" 2>&1
    else
        nohup "$script_path" --worker "$action" \
            </dev/null >>"$log_file" 2>&1 &
        disown || true
    fi
    printf 'desktop-shell: switch requested: %s\n' "$action"
}

wait_for_process() {
    local process_name="$1"
    local expected="$2"
    local attempt=0
    while ((attempt < 50)); do
        if process_running "$process_name"; then
            [[ "$expected" == running ]] && return 0
        else
            [[ "$expected" == stopped ]] && return 0
        fi
        sleep 0.1
        ((attempt += 1))
    done
    return 1
}

process_running() {
    local process_name="$1"
    local process_state

    while IFS= read -r process_state; do
        process_state="${process_state//[[:space:]]/}"
        [[ -n "$process_state" && "$process_state" != Z* ]] && return 0
    done < <(ps -C "$process_name" -o stat= 2>/dev/null || true)
    return 1
}

quickshell_ipc() {
    qs ipc --path "$quickshell_config" "$@"
}

quickshell_ipc_call() {
    quickshell_ipc call "$@"
}

quickshell_ipc_call_output() {
    local output=""
    if command -v timeout >/dev/null 2>&1; then
        output="$(timeout 1s qs ipc --path "$quickshell_config" call "$@" 2>/dev/null || true)"
    else
        output="$(qs ipc --path "$quickshell_config" call "$@" 2>/dev/null || true)"
    fi
    output="${output%%$'\n'*}"
    output="${output//$'\r'/}"
    output="${output#"${output%%[![:space:]]*}"}"
    output="${output%"${output##*[![:space:]]}"}"
    printf '%s\n' "$output"
}

quickshell_running() {
    command -v qs >/dev/null 2>&1 || return 1
    if command -v timeout >/dev/null 2>&1; then
        timeout 1s qs ipc --path "$quickshell_config" show >/dev/null 2>&1
    else
        qs ipc --path "$quickshell_config" show >/dev/null 2>&1
    fi
}

probe_desktop_integration() {
    local output=""

    [[ "$desktop_integration_probed" == true ]] && return 0
    desktop_integration_probed=true
    desktop_integration_version=""

    quickshell_running || return 1
    output="$(quickshell_ipc_call_output desktop-integration version)"
    [[ -n "$output" ]] || return 1
    desktop_integration_version="$output"
    return 0
}

has_desktop_integration() {
    probe_desktop_integration || return 1
    [[ "$desktop_integration_version" == "1" || "$desktop_integration_version" == "2" ]]
}

has_idle_ipc() {
    quickshell_running || return 1
    if command -v timeout >/dev/null 2>&1; then
        timeout 1s qs ipc --path "$quickshell_config" call idle owner >/dev/null 2>&1
    else
        qs ipc --path "$quickshell_config" call idle owner >/dev/null 2>&1
    fi
}

wait_for_quickshell() {
    local expected="$1"
    local attempt=0
    while ((attempt < 60)); do
        if quickshell_running; then
            [[ "$expected" == running ]] && return 0
        else
            [[ "$expected" == stopped ]] && return 0
        fi
        sleep 0.1
        ((attempt += 1))
    done
    return 1
}

wait_for_desktop_integration_ready() {
    local attempt=0
    local output=""

    if ! has_desktop_integration; then
        ! quickshell_is_upstream_tree
        return $?
    fi

    while ((attempt < 60)); do
        output="$(quickshell_ipc_call_output desktop-integration ping)"
        case "$output" in
            READY)
                return 0
                ;;
            PENDING | "")
                ;;
            *)
                log "QuickShell desktop-integration ping returned: ${output:-<empty>}"
                return 1
                ;;
        esac
        sleep 0.1
        ((attempt += 1))
    done
    log "QuickShell desktop-integration ping timed out while PENDING"
    return 1
}

settle_quickshell_wallpaper() {
    # Version 2 owns wallpaper handoff itself, including a saved WC backend.
    # Never fall back to stop when the new protocol is unavailable or pending.
    if [[ "$desktop_integration_version" != "2" ]]; then
        run_wallpaper_console stop
        return $?
    fi
    local output="" attempt=0
    while ((attempt < 100)); do
        output="$(quickshell_ipc_call_output desktop-integration settleWallpaper)"
        case "$output" in
            WC | WC_FALLBACK | LOCAL) return 0 ;;
            PENDING | "") ;;
            *) log "wallpaper handoff failed: ${output}"; return 1 ;;
        esac
        sleep 0.1
        ((attempt += 1))
    done
    log "wallpaper handoff timed out; preserving renderer ownership"
    return 1
}

prepare_quickshell_for_waybar() {
    local attempt=0
    local output=""

    quickshell_prepared_for_waybar=false
    quickshell_wallpaper_retained=false
    if ! has_desktop_integration; then
        ! quickshell_is_upstream_tree
        return $?
    fi

    # Even PENDING or a lost response may have changed the wallpaper owner.
    quickshell_prepared_for_waybar=true
    output="$(quickshell_ipc_call_output desktop-integration prepareWaybar)"
    case "$output" in
        READY_WC)
            [[ "$desktop_integration_version" == "2" ]] || return 1
            quickshell_wallpaper_retained=true
            return 0
            ;;
        READY)
            quickshell_prepared_for_waybar=true
            return 0
            ;;
        PENDING) ;;
        *)
            log "QuickShell prepareWaybar returned: ${output:-<empty>}"
            return 1
            ;;
    esac

    while ((attempt < 50)); do
        output="$(quickshell_ipc_call_output desktop-integration prepareWaybar)"
        case "$output" in
            READY_WC)
                [[ "$desktop_integration_version" == "2" ]] || return 1
                quickshell_wallpaper_retained=true
                return 0
                ;;
            READY)
                quickshell_prepared_for_waybar=true
                return 0
                ;;
            PENDING) ;;
            *)
                log "QuickShell prepareWaybar returned: ${output:-<empty>}"
                return 1
                ;;
        esac
        sleep 0.1
        ((attempt += 1))
    done

    log "QuickShell prepareWaybar timed out while PENDING"
    return 1
}

resume_quickshell_after_prepare() {
    [[ "$quickshell_prepared_for_waybar" == true ]] || return 0
    quickshell_prepared_for_waybar=false
    quickshell_running || return 0
    has_desktop_integration || return 0
    local output=""
    output="$(quickshell_ipc_call_output desktop-integration resume)"
    if [[ "$output" != READY ]]; then
        log "warning: QuickShell resume returned: ${output:-<empty>}"
        return 1
    fi
    return 0
}

stop_quickshell() {
    local escaped_config
    local exact_stop=false

    # Upstream must not globally pkill quickshell: auxiliary configs such as the
    # mode switcher share that process name. Stop only the selected main path
    # and the supervisor that relaunches it.
    if quickshell_is_upstream_tree || has_desktop_integration; then
        exact_stop=true
    fi

    qs kill --path "$quickshell_config" >>"$log_file" 2>&1 || true
    escaped_config="$(printf '%s' "$quickshell_config" \
        | sed 's/[][\\.^$*+?(){}|]/\\&/g')"
    pkill -f -- "(^|/)qs .*--path $escaped_config($| )" \
        >/dev/null 2>&1 || true
    if [[ "$exact_stop" == false ]]; then
        pkill -x quickshell >/dev/null 2>&1 || true
    fi
    if wait_for_quickshell stopped; then
        reset_desktop_integration_cache
        return 0
    fi
    return 1
}

ensure_process() {
    local process_name="$1"
    shift
    process_running "$process_name" && return 0
    start_detached "$@"
    wait_for_process "$process_name" running
}

stop_process() {
    local process_name="$1"
    process_running "$process_name" || return 0
    pkill -x "$process_name" >/dev/null 2>&1 || true
    wait_for_process "$process_name" stopped
}

stop_waybar_companions() {
    pkill -f -- "^/bin/bash ${XDG_CONFIG_HOME:-$HOME/.config}/waybar/scripts/cava\\.sh$" \
        >/dev/null 2>&1 || true
    pkill -f -- '^cava -p /tmp/waybar_cava_config$' \
        >/dev/null 2>&1 || true
}

notification_owner_comm() {
    command -v busctl >/dev/null 2>&1 || return 1
    busctl --user status "$notification_bus_name" 2>/dev/null \
        | sed -n 's/^Comm=//p'
}

secret_service_running() {
    command -v busctl >/dev/null 2>&1 || return 1
    busctl --user status org.freedesktop.secrets >/dev/null 2>&1
}

ensure_secret_service() {
    local candidate attempt

    secret_service_running && return 0

    # Ask D-Bus for the standard service first, then KDE's compatibility
    # provider. This keeps the shell independent of a provider executable and
    # also works when another implementation owns org.freedesktop.secrets.
    for candidate in \
        org.freedesktop.secrets \
        org.kde.secretservicecompat; do
        busctl --user call \
            org.freedesktop.DBus \
            /org/freedesktop/DBus \
            org.freedesktop.DBus \
            StartServiceByName \
            su "$candidate" 0 >/dev/null 2>&1 || true

        attempt=0
        while ((attempt < 20)); do
            secret_service_running && return 0
            sleep 0.05
            ((attempt += 1))
        done
    done

    return 1
}

wait_for_quickshell_notification_owner() {
    local attempt=0
    local owner_comm=""
    while ((attempt < 60)); do
        quickshell_running || return 1
        owner_comm="$(notification_owner_comm || true)"
        case "$owner_comm" in
            qs | quickshell)
                return 0
                ;;
            mako)
                stop_process mako || return 1
                ;;
            "")
                ;;
            *)
                log "cannot activate QuickShell notifications: owned by $owner_comm"
                return 1
                ;;
        esac
        sleep 0.1
        ((attempt += 1))
    done
    return 1
}

write_state() {
    local mode="$1"
    printf '%s\n' "$mode" >"$state_file.tmp"
    mv -f "$state_file.tmp" "$state_file"
}

ensure_mako() {
    local mako_bin
    mako_bin="$(command -v mako 2>/dev/null || true)"
    [[ -n "$mako_bin" ]] || {
        log "mako is unavailable"
        return 1
    }
    ensure_process mako "$mako_bin"
}

ensure_swayidle() {
    if [[ -f "$idle_control_marker" ]]; then
        stop_swayidle
        log "skipped legacy swayidle because Idle Control is active"
        return 0
    fi
    [[ -x "$swayidle_script" ]] || {
        log "swayidle script is unavailable: $swayidle_script"
        return 1
    }
    ensure_process swayidle "$swayidle_script"
}

stop_swayidle() {
    stop_process swayidle || true
    pkill -f -- "$swayidle_script" >/dev/null 2>&1 || true
}

sync_quickshell_idle_owner() {
    local external_owner=false
    local require_success=false

    quickshell_running || return 0
    [[ -f "$idle_control_marker" ]] && external_owner=true && require_success=true

    if qs ipc --path "$quickshell_config" call idle setExternalOwner "$external_owner" \
            >>"$log_file" 2>&1; then
        return 0
    fi

    if [[ "$require_success" == true ]]; then
        # Upstream (and any shell that advertises idle IPC) must honor the
        # external-owner marker before Waybar is removed. Legacy trees without
        # the idle handler may still warn and continue.
        if quickshell_is_upstream_tree || has_desktop_integration || has_idle_ipc; then
            log "cannot synchronize QuickShell idle ownership while Idle Control is active"
            return 1
        fi
        log "warning: legacy QuickShell idle ownership capability is unavailable"
        return 0
    fi

    log "warning: QuickShell idle ownership could not be synchronized"
    return 0
}

run_wallpaper_console() {
    local action="$1"
    command -v wallpaper-console-rust >/dev/null 2>&1 || return 0
    wallpaper-console-rust "$action" >>"$log_file" 2>&1 9>&-
}

activate_waybar() {
    local waybar_bin
    local waybar_was_running=false
    waybar_bin="$(command -v waybar 2>/dev/null || true)"
    if [[ -z "$waybar_bin" ]]; then
        log "cannot activate waybar: binary not found"
        notify "Waybar is not installed"
        return 1
    fi

    if process_running waybar; then
        waybar_was_running=true
    fi

    local brightness_build="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/cffi/build.sh"
    if [[ -x "$brightness_build" ]] && ! "$brightness_build" >>"$log_file" 2>&1; then
        log "cannot activate Waybar: brightness module build failed"
        notify "Waybar brightness module could not be prepared"
        return 1
    fi

    # Keep the current shell visible until Waybar has successfully appeared.
    if ! ensure_process waybar "$waybar_bin"; then
        log "cannot activate waybar: process did not start"
        notify "Waybar failed to start; QuickShell was kept"
        return 1
    fi

    if quickshell_running; then
        if ! prepare_quickshell_for_waybar; then
            log "cannot activate Waybar: QuickShell did not prepare for handoff"
            resume_quickshell_after_prepare \
                || log "warning: QuickShell did not resume after prepare failure"
            if [[ "$waybar_was_running" == false ]]; then
                stop_process waybar || true
            fi
            notify "QuickShell could not prepare for Waybar; QuickShell was kept"
            return 1
        fi
    fi

    if [[ "$quickshell_wallpaper_retained" != true ]] && ! run_wallpaper_console restore; then
        log "cannot activate Waybar: Wallpaper Console did not restore"
        resume_quickshell_after_prepare \
            || log "warning: QuickShell did not resume after Wallpaper Console restore failure"
        if quickshell_running || [[ "$waybar_was_running" == false ]]; then
            stop_process waybar || true
        fi
        notify "Wallpaper could not be restored; QuickShell was kept"
        return 1
    fi

    if quickshell_running; then
        if ! stop_quickshell; then
            log "cannot activate Waybar: QuickShell did not stop"
            resume_quickshell_after_prepare \
                || log "warning: QuickShell did not resume during rollback"
            if [[ "$desktop_integration_version" != "2" ]]; then
                run_wallpaper_console stop \
                    || log "warning: Wallpaper Console did not stop during rollback"
            fi
            stop_process waybar || log "warning: Waybar did not stop during rollback"
            notify "QuickShell did not stop; Waybar switch was rolled back"
            return 1
        fi
    fi

    ensure_mako || log "warning: Mako did not start"
    ensure_swayidle || log "warning: swayidle did not start"
    write_state waybar
    log "activated waybar"
    notify "Waybar mode"
}

activate_quickshell() {
    local qs_bin
    qs_bin="$(command -v qs 2>/dev/null || true)"
    if [[ -z "$qs_bin" || ! -f "$quickshell_config/shell.qml" ]]; then
        log "cannot activate QuickShell: config unavailable at $quickshell_config"
        notify "QuickShell config is unavailable"
        return 1
    fi

    ensure_secret_service \
        || log "warning: no Secret Service provider is available; weather API keys cannot be read"

    if quickshell_running; then
        if ! quickshell_is_upstream_tree; then
            qs ipc --path "$quickshell_config" \
                call weather-map reloadCredentials >/dev/null 2>&1 \
                || log "warning: weather credentials could not be refreshed"
        fi
        stop_process mako || true
        if ! wait_for_quickshell_notification_owner; then
            log "cannot reconcile QuickShell: notification ownership was not acquired"
            ensure_mako || log "warning: Mako did not restart after notification ownership failure"
            notify "QuickShell could not acquire notifications"
            return 1
        fi
        if ! wait_for_desktop_integration_ready; then
            log "cannot reconcile QuickShell: desktop integration was not ready"
            ensure_mako || log "warning: Mako did not restart after readiness failure"
            notify "QuickShell did not become ready"
            return 1
        fi
        if ! sync_quickshell_idle_owner; then
            log "cannot reconcile QuickShell: idle ownership sync failed"
            ensure_mako || log "warning: Mako did not restart after idle sync failure"
            notify "QuickShell idle ownership could not be synchronized"
            return 1
        fi
        if ! settle_quickshell_wallpaper; then
            log "cannot reconcile QuickShell: wallpaper ownership did not settle"
            notify "Wallpaper ownership could not be settled"
            return 1
        fi
        if ! stop_process waybar; then
            log "cannot reconcile QuickShell: Waybar did not stop"
            notify "Waybar could not be stopped"
            return 1
        fi
        stop_waybar_companions
        stop_swayidle
        write_state quickshell
        log "QuickShell was already running; reconciled companion services"
        notify "QuickShell mode"
        return 0
    fi

    # QuickShell owns org.freedesktop.Notifications. Stop Mako before launch so
    # the notification server is registered during initial configuration load.
    stop_process mako || true
    reset_desktop_integration_cache
    # Prefer a direct Quickshell path launch. key shell is unnecessary when the
    # selected tree already provides shell.qml; CLAVIS_KEY is left for the shell.
    start_detached "$qs_bin" --no-duplicate --path "$quickshell_config"

    if ! wait_for_quickshell running; then
        log "QuickShell failed to become ready; restoring Waybar companions"
        stop_quickshell || log "warning: QuickShell supervisor did not stop after startup failure"
        ensure_mako || true
        notify "QuickShell failed to start; Waybar was kept"
        return 1
    fi

    if ! wait_for_quickshell_notification_owner; then
        log "QuickShell failed to acquire notification ownership; restoring Waybar companions"
        stop_quickshell || log "warning: QuickShell did not stop after notification ownership failure"
        ensure_mako || log "warning: Mako did not restart after notification ownership failure"
        notify "QuickShell could not acquire notifications; Waybar was kept"
        return 1
    fi

    if ! wait_for_desktop_integration_ready; then
        log "QuickShell desktop integration was not ready; restoring Waybar companions"
        stop_quickshell || log "warning: QuickShell did not stop after readiness failure"
        ensure_mako || log "warning: Mako did not restart after readiness failure"
        notify "QuickShell did not become ready; Waybar was kept"
        return 1
    fi

    if ! sync_quickshell_idle_owner; then
        log "cannot activate QuickShell: idle ownership sync failed before removing Waybar"
        stop_quickshell || log "warning: QuickShell did not stop after idle sync failure"
        ensure_mako || log "warning: Mako did not restart after idle sync failure"
        notify "QuickShell idle ownership could not be synchronized; Waybar was kept"
        return 1
    fi

    if ! settle_quickshell_wallpaper; then
        log "cannot activate QuickShell: wallpaper ownership did not settle"
        if ! stop_quickshell; then
            log "warning: QuickShell did not stop cleanly during rollback"
        fi
        ensure_mako || log "warning: Mako did not restart during rollback"
        notify "Wallpaper ownership could not be settled; Waybar was kept"
        return 1
    fi

    if ! stop_process waybar; then
        log "cannot activate QuickShell: Waybar did not stop"
        if stop_quickshell; then
            run_wallpaper_console restore \
                || log "warning: Wallpaper Console did not restore during rollback"
        else
            log "warning: QuickShell did not stop cleanly during rollback"
        fi
        ensure_mako || log "warning: Mako did not restart during rollback"
        notify "Waybar did not stop; QuickShell switch was rolled back"
        return 1
    fi
    stop_waybar_companions
    stop_swayidle
    write_state quickshell
    log "activated QuickShell from $quickshell_config"
    notify "QuickShell mode"
}

start_saved_mode() {
    local saved_mode=waybar

    case "$desktop_shell_profile" in
        waybar)
            activate_waybar
            return
            ;;
        quickshell)
            activate_quickshell
            return
            ;;
    esac

    if [[ -f "$state_file" ]]; then
        read -r saved_mode <"$state_file" || saved_mode=waybar
    fi

    if [[ "$saved_mode" == quickshell ]]; then
        if ! activate_quickshell; then
            log "falling back to Waybar after QuickShell startup failure"
            activate_waybar
        fi
    else
        activate_waybar
    fi
}

call_quickshell() {
    local target="$1"
    local function_name="$2"
    shift 2
    quickshell_running || return 1
    qs ipc --path "$quickshell_config" call "$target" "$function_name" "$@"
}

uses_upstream_ipc() {
    has_desktop_integration && return 0
    quickshell_is_upstream_tree
}

show_switcher() {
    local switcher_config="$quickshell_config/switcher.qml"

    if qs ipc --path "$switcher_config" call shell-switcher show \
            >/dev/null 2>&1; then
        return 0
    fi

    [[ -f "$switcher_config" ]] || {
        notify "Desktop mode switcher is unavailable"
        return 1
    }
    start_detached qs --no-duplicate --path "$switcher_config"

    local attempt=0
    while ((attempt < 30)); do
        if qs ipc --path "$switcher_config" call shell-switcher show \
                >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.05
        attempt=$((attempt + 1))
    done
    notify "Desktop mode switcher did not become ready"
    return 1
}

mode_label() {
    case "$1" in
        waybar) printf 'Waybar' ;;
        quickshell) printf 'QuickShell' ;;
        none) printf 'Not running' ;;
        *) printf '%s' "$1" ;;
    esac
}

print_plain_status() {
    local configured="$1"
    local active="$2"
    local switching=0
    switch_lock_available || switching=1
    printf 'profile=%s\nconfigured=%s\nactive=%s\nquickshell_config=%s\n' \
        "$desktop_shell_profile" "$configured" "$active" "$quickshell_config"
    printf 'switching=%s\n' "$switching"
}

print_pretty_status() {
    local configured="$1"
    local active="$2"
    local config_display="${quickshell_config/#"$HOME"/\~}"
    local configured_label active_label
    local reset="" bold="" dim="" blue="" green="" yellow="" red=""
    local active_color active_icon

    configured_label="$(mode_label "$configured")"
    active_label="$(mode_label "$active")"

    if [[ -z "${NO_COLOR:-}" && "${TERM:-}" != dumb ]]; then
        reset=$'\033[0m'
        bold=$'\033[1m'
        dim=$'\033[2m'
        blue=$'\033[34m'
        green=$'\033[32m'
        yellow=$'\033[33m'
        red=$'\033[31m'
    fi

    if [[ "$active" == none ]]; then
        active_color="$red"
        active_icon="○"
    elif [[ "$active" == "$configured" ]]; then
        active_color="$green"
        active_icon="●"
    else
        active_color="$yellow"
        active_icon="●"
    fi

    printf '%s╭─%s %sDesktop Shell%s\n' "$blue" "$reset" "$bold" "$reset"
    printf '%s│%s  %s◇%s  %-9s %s\n' \
        "$blue" "$reset" "$blue" "$reset" "Profile" "$desktop_shell_profile"
    printf '%s│%s  %s%s%s  %-9s %s%s%s\n' \
        "$blue" "$reset" "$active_color" "$active_icon" "$reset" \
        "Active" "$bold" "$active_label" "$reset"
    printf '%s│%s  %s◆%s  %-9s %s\n' \
        "$blue" "$reset" "$blue" "$reset" "Saved" "$configured_label"
    printf '%s│%s  %s◇%s  %-9s %s%s%s\n' \
        "$blue" "$reset" "$blue" "$reset" "Config" "$dim" "$config_display" "$reset"
    printf '%s╰─%s %sMod+Shift+7 · desktop-shell toggle%s\n' \
        "$blue" "$reset" "$dim" "$reset"
}

show_status() {
    local configured=waybar
    local active

    [[ -f "$state_file" ]] && read -r configured <"$state_file" || true
    if quickshell_running; then
        active=quickshell
    elif process_running waybar; then
        active=waybar
    else
        active=none
    fi

    if [[ "$status_format" == plain ]]; then
        print_plain_status "$configured" "$active"
        return
    fi

    case "${DESKTOP_SHELL_STATUS_STYLE:-auto}" in
        pretty)
            print_pretty_status "$configured" "$active"
            ;;
        plain)
            print_plain_status "$configured" "$active"
            ;;
        auto | *)
            if [[ -t 1 ]]; then
                print_pretty_status "$configured" "$active"
            else
                print_plain_status "$configured" "$active"
            fi
            ;;
    esac
}

if [[ "$worker_mode" == false ]]; then
    case "$action" in
        start | toggle | waybar | quickshell)
            validate_profile_action || exit 1
            dispatch_switch
            exit $?
            ;;
    esac
else
    validate_profile_action || exit 1
    acquire_switch_lock || exit 1
fi

case "$action" in
    start)
        notify_enabled=0
        start_saved_mode
        ;;
    toggle)
        if quickshell_running; then
            activate_waybar
        else
            activate_quickshell
        fi
        ;;
    waybar)
        activate_waybar
        ;;
    quickshell)
        activate_quickshell
        ;;
    status)
        show_status
        ;;
    switcher)
        show_switcher
        ;;
    launcher)
        if uses_upstream_ipc; then
            call_quickshell spotlight toggle || exec fuzzel
        else
            call_quickshell launcher toggle || exec fuzzel
        fi
        ;;
    lock)
        call_quickshell lock open || exec swaylock -f
        ;;
    hub)
        call_quickshell keystone hub || notify "Switch to QuickShell to use Keystone"
        ;;
    tools)
        call_quickshell keystone tools || notify "Switch to QuickShell to use Keystone tools"
        ;;
    control-center)
        if quickshell_running; then
            if uses_upstream_ipc; then
                call_quickshell control-center toggle "" \
                    || notify "QuickShell control center is unavailable"
            else
                start_detached qs --no-duplicate --path "$quickshell_config/controlcenter.qml"
            fi
        else
            notify "Switch to QuickShell to use its control center"
        fi
        ;;
esac
