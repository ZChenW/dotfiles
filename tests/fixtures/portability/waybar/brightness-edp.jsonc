{
  "backlight/slider": {
    "min": 5,
    "max": 98,
    "orientation": "horizontal",
    "device": "amdgpu_bl1"
  },
  "backlight": {
    "device": "amdgpu_bl1",
    "tooltip": true,
    "tooltip-format": "此屏幕亮度\n滚轮调节",
    "format": "{icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "on-scroll-up": "~/.config/niri/scripts/brightness.sh --output internal +5%",
    "on-scroll-down": "~/.config/niri/scripts/brightness.sh --output internal -5%"
  },
  "group/ddcutil": {
    "orientation": "inherit",
    "drawer": {
      "transition-left-to-right": false
    },
    "modules": [
      "backlight#stat",
      "backlight/slider",
      "backlight",
      "custom/separator#1",
      "custom/ddcutil-sleep",
      "custom/ddcutil-night"
    ]
  },
  "backlight#stat": {
    "device": "amdgpu_bl1",
    "tooltip-format": "此屏幕亮度：{percent}%\n左键：100%\n滚轮：±5%\n右键：切换护眼模式",
    "format": "󰃠 {percent}%",
    "on-click": "~/.config/niri/scripts/brightness.sh --output internal --set-percent 100",
    "on-click-right": "~/.local/bin/toggle-wlsunset",
    "on-scroll-up": "~/.config/niri/scripts/brightness.sh --output internal +5%",
    "on-scroll-down": "~/.config/niri/scripts/brightness.sh --output internal -5%"
  },
  "custom/ddcutil-night": {
    "tooltip-format": "左键：65%此屏幕亮度\n滚轮：±5%",
    "format": "󰃟",
    "on-click": "~/.config/niri/scripts/brightness.sh --output internal --set-percent 65",
    "on-scroll-up": "~/.config/niri/scripts/brightness.sh --output internal +5%",
    "on-scroll-down": "~/.config/niri/scripts/brightness.sh --output internal -5%"
  },
  "custom/ddcutil-sleep": {
    "tooltip-format": "左键：5%此屏幕亮度\n滚轮：±5%",
    "format": "󰃞",
    "on-click": "~/.config/niri/scripts/brightness.sh --output internal --set-percent 5",
    "on-scroll-up": "~/.config/niri/scripts/brightness.sh --output internal +5%",
    "on-scroll-down": "~/.config/niri/scripts/brightness.sh --output internal -5%"
  }
}
